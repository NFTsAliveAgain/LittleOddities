# Copy to .env.local for development. Never commit real values.

# --- Public (shown in the browser; safe to expose) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN=sepolia                     # sepolia | mainnet
NEXT_PUBLIC_CONTRACT_ADDRESS=                 # set after deployment (from contracts/deployments/*.json)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=         # free at https://cloud.reown.com
NEXT_PUBLIC_LAUNCH_ISO=2027-11-03T12:00:00-04:00   # official launch moment
NEXT_PUBLIC_LAUNCH_TZ=America/New_York        # timezone shown to visitors
NEXT_PUBLIC_IMAGES_BASE=                      # e.g. https://<gateway>/ipfs/<IMAGES_CID>/  (empty = placeholder cards)
NEXT_PUBLIC_RPC_URL=                          # optional; defaults to public RPC

# --- Server only (never exposed to the browser) ---
ADMIN_ADDRESSES=0xYourOwnerWalletAddress      # comma separated PUBLIC addresses allowed into /admin
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=file:data/local.db               # production: libsql://<db>.turso.io
DATABASE_AUTH_TOKEN=                          # production Turso token
