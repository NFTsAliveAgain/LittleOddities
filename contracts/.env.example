# Copy this file to ".env" and fill it in. NEVER commit .env or share it.
# Use a separate, freshly created DEPLOYER wallet that only holds the ETH needed for deployment.
# Never use your main owner wallet's key here, and never paste a seed phrase anywhere.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# Deployment settings (public information)
OWNER_ADDRESS=0x0000000000000000000000000000000000000000
BASE_URI=ipfs://__METADATA_CID__/
CONTRACT_URI=ipfs://__COLLECTION_CID__/collection.json
WALLET_LIMIT=10
ROYALTY_BPS=500
