  "rules": [
    {
      "_why": "Skin and background must not share a colour family (keeps every character readable).",
      "type": "no_shared_family",
      "a": "skin",
      "b": "background"
    },
    {
      "_why": "Eyewear is built for two eyes.",
      "type": "exclude",
      "a": {
        "eyes": [
          "Cyclops"
        ]
      },
      "b": {
        "eyewear": [
          "Round Specs",
          "Shades",
          "3D Glasses",
          "Aviators",
          "Eyepatch",
          "Monocle"
        ]
      }
    },
    {
      "_why": "Headphone cups sit where ears, earrings and the mic go.",
      "type": "exclude",
      "a": {
        "headwear": [
          "Headphones"
        ]
      },
      "b": {
        "accessory": [
          "Stud Earring",
          "Hoop Earring",
          "Headset Mic"
        ]
      }
    },
    {
      "_why": "Headphone cups clash with fin ears.",
      "type": "exclude",
      "a": {
        "headwear": [
          "Headphones"
        ]
      },
      "b": {
        "ears": [
          "Fins"
        ]
      }
    },
    {
      "_why": "Cape clasp / space-suit ring replace neck jewellery and pins.",
      "type": "exclude",
      "a": {
        "clothing": [
          "Royal Cape",
          "Space Suit"
        ]
      },
      "b": {
        "accessory": [
          "Silver Chain",
          "Gold Chain",
          "Sprout Pin"
        ]
      }
    },
    {
      "_why": "Bandage covers the right cheek.",
      "type": "exclude",
      "a": {
        "accessory": [
          "Cheek Bandage"
        ]
      },
      "b": {
        "markings": [
          "Cheek Stripes",
          "Face Paint",
          "Spots"
        ]
      }
    },
    {
      "_why": "Shades/visor/3D glasses cover the eyes, so special eyes would be hidden.",
      "type": "exclude",
      "a": {
        "eyewear": [
          "Shades",
          "Visor",
          "3D Glasses",
          "Eyepatch"
        ]
      },
      "b": {
        "eyes": [
          "Glowing",
          "Gold",
          "Hypno",
          "Wink"
        ]
      }
    },
    {
      "_why": "Bubblegum covers the mouth area where the nose ring hangs.",
      "type": "exclude",
      "a": {
        "mouth": [
          "Bubblegum"
        ]
      },
      "b": {
        "accessory": [
          "Nose Ring"
        ]
      }
    },
    {
      "_why": "Dark skins need a lighter background.",
      "type": "exclude",
      "a": {
        "skin": [
          "Midnight",
          "Inkblot",
          "Cosmic"
        ]
      },
      "b": {
        "background": [
          "Cosmos",
          "Slate",
          "Brick Wall"
        ]
      }
    },
    {
      "_why": "Pale skins disappear on grey/blue-grey backgrounds.",
      "type": "exclude",
      "a": {
        "skin": [
          "Chrome",
          "Holo",
          "Mint",
          "Ash",
          "Zombie",
          "Sky",
          "Slate"
        ]
      },
      "b": {
        "background": [
          "Slate",
          "Periwinkle"
        ]
      }
    }
  ]
}