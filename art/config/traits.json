          "Tail"
        ]
      }
    },
    {
      "_why": "Glasses can't sit over goggles or the space helmet visor.",
      "type": "exclude",
      "a": {
        "accessory": [
          "Glasses"
        ]
      },
      "b": {
        "eyes": [
          "Goggles"
        ]
      }
    },
    {
      "_why": "Glasses can't sit inside the space helmet.",
      "type": "exclude",
      "a": {
        "accessory": [
