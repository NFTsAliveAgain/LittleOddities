  "rules": [
    {"_why": "Skin and background must not share a colour family (keeps every character readable).", "type": "no_shared_family", "a": "skin", "b": "background"},
    {"_why": "Glasses need two eyes side by side.", "type": "exclude", "a": {"eyes": ["Cyclops", "Triple"]}, "b": {"accessory": ["Round Glasses"]}},
    {"_why": "Tuxedo already has its own bow tie; capes/robes/collars clash with neckwear.", "type": "exclude", "a": {"clothing": ["Tuxedo", "Sailor Collar", "Hero Cape", "Royal Robe"]}, "b": {"accessory": ["Bow Tie", "Scarf"]}},
    {"_why": "Tall hats collide with the rain cloud and halo floats where tall hats sit.", "type": "exclude", "a": {"headwear": ["Party Hat", "Wizard Hat", "Traffic Cone", "Birthday Candle", "Halo", "Propeller Cap"]}, "b": {"special": ["Rain Cloud"]}},
    {"_why": "Patterns on a Constellation body would be hidden; constellation replaces the skin pattern.", "type": "exclude", "a": {"pattern": ["Constellation"]}, "b": {"skin": ["Gold", "Opal", "Chrome", "Sherbet"]}},
    {"_why": "Little Buddy sits at the feet; the ghost-like Wisplet floats and the orbit crosses that spot.", "type": "exclude", "a": {"special": ["Little Buddy"]}, "b": {"species": ["Wisplet"]}},
    {"_why": "Held items need arms (Twinklet has star points instead).", "type": "exclude", "a": {"species": ["Twinklet"]}, "b": {"accessory": ["Lollipop", "Balloon", "Star Wand"]}},
    {"_why": "Balloon floats at upper right where heart bubbles and bubbles go.", "type": "exclude", "a": {"accessory": ["Balloon"]}, "b": {"special": ["Heart Bubbles", "Bubbles", "Sparkles"]}},
    {"_why": "Monocle needs a visible open eye.", "type": "exclude", "a": {"accessory": ["Monocle", "Round Glasses"]}, "b": {"eyes": ["Happy Arcs", "Wink"]}},
    {"_why": "Dark backgrounds need a light enough body, and dark skins need a light background.", "type": "exclude", "a": {"skin": ["Midnight", "Plum", "Cocoa"]}, "b": {"background": ["Twilight Stars", "Cosmic Void"]}}
  ]
}
