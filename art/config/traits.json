  "rules": [
    {
      "_why": "Body colour and background must not share a colour family.",
      "type": "no_shared_family",
      "a": "color",
      "b": "background"
    },
    {
      "_why": "Horns and antennae poke through most hats.",
      "type": "exclude",
      "a": {
        "special": [
          "Horns",
          "Antenna",
          "Halo"
        ]
      },
      "b": {
        "headwear": [
          "Antenna",
          "Sparkles",
          "Tail",
          "Little Buddy",
          "Rain Cloud",
          "Horns",
          "Third Eye",
          "Wings",
          "Fire Aura",
          "Ice Aura",
          "Glow",
          "Halo"
        ]
      }
    },
    {
      "_why": "Wings and cape/backpack occupy the same space behind the body.",
      "type": "exclude",
      "a": {
        "special": [
          "Wings"
        ]
      },
      "b": {
        "clothing": [
          "Cape",
          "Robe"
        ]
      }
    },
    {
      "_why": "Backpack straps clash with capes and wings.",
      "type": "exclude",
      "a": {
        "accessory": [
          "Backpack"
        ]
      },
      "b": {
        "clothing": [
          "Cape",
          "Astronaut Suit"
        ]
      }
    },
    {
      "_why": "Ghosts float: no skateboard, no tail.",
      "type": "exclude",
      "a": {
        "species": [
          "Ghost"
        ]
      },
      "b": {
        "accessory": [
          "Skateboard"
        ]
      }
    },
    {
      "_why": "Ghosts float: no tail.",
